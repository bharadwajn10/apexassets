# Handle line endings automatically for files detected as text 
# and perform LF normalization.
* text=auto

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.flv binary
*.fla binary
*.swf binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
*.pdf binary

# Explicitly declare text files you want to always be normalized and converted 
# to native line endings on checkout.
*.dart text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.plist text eol=lf
*.storyboard text eol=lf
*.xib text eol=lf
*.swift text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.txt text eol=lf

# Ensure lcov.info always has LF line endings
lcov.info text eol=lf
